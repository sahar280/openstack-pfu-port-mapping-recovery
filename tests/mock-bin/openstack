#!/bin/bash

TRUNK_01="11111111-1111-4111-8111-111111111111"
TRUNK_02="99999999-9999-4999-8999-999999999999"

if [ "$1 $2 $3" = "network trunk list" ]; then
    cat <<'EOF'
+--------------------------------------+-------------------+--------+
| ID                                   | Name              | Status |
+--------------------------------------+-------------------+--------+
| 11111111-1111-4111-8111-111111111111 | pfu-demo-trunk-01 | ACTIVE |
| 99999999-9999-4999-8999-999999999999 | pfu-demo-trunk-02 | ACTIVE |
+--------------------------------------+-------------------+--------+
EOF
elif [ "$1 $2 $3" = "network trunk show" ] && [ "${5:-}" = "-f" ]; then
    case "${4:-}" in
        "$TRUNK_01") echo "pfu-demo-trunk-01" ;;
        "$TRUNK_02") echo "pfu-demo-trunk-02" ;;
        *) printf 'Unknown synthetic trunk: %s\n' "${4:-}" >&2; exit 1 ;;
    esac
elif [ "$1 $2 $3" = "network trunk show" ]; then
    case "${4:-}" in
        "$TRUNK_01")
            cat <<'EOF'
+-----------+------------------------------------------------------------------------------------------+
| Field     | Value                                                                                    |
+-----------+------------------------------------------------------------------------------------------+
| sub_ports | port_id='21000000-0000-4000-8000-000000000001', segmentation_id='101'                    |
|           | port_id='21000000-0000-4000-8000-000000000002', segmentation_id='102'                    |
|           | port_id='21000000-0000-4000-8000-000000000003', segmentation_id='103'                    |
|           | port_id='21000000-0000-4000-8000-000000000004', segmentation_id='104'                    |
|           | port_id='21000000-0000-4000-8000-000000000005', segmentation_id='105'                    |
|           | port_id='21000000-0000-4000-8000-000000000006', segmentation_id='106'                    |
|           | port_id='21000000-0000-4000-8000-000000000007', segmentation_id='107'                    |
|           | port_id='21000000-0000-4000-8000-000000000008', segmentation_id='108'                    |
+-----------+------------------------------------------------------------------------------------------+
EOF
            ;;
        "$TRUNK_02")
            cat <<'EOF'
+-----------+------------------------------------------------------------------------------------------+
| Field     | Value                                                                                    |
+-----------+------------------------------------------------------------------------------------------+
| sub_ports | port_id='22000000-0000-4000-8000-000000000001', segmentation_id='201'                    |
|           | port_id='22000000-0000-4000-8000-000000000002', segmentation_id='202'                    |
|           | port_id='22000000-0000-4000-8000-000000000003', segmentation_id='203'                    |
|           | port_id='22000000-0000-4000-8000-000000000004', segmentation_id='204'                    |
|           | port_id='22000000-0000-4000-8000-000000000005', segmentation_id='205'                    |
|           | port_id='22000000-0000-4000-8000-000000000006', segmentation_id='206'                    |
|           | port_id='22000000-0000-4000-8000-000000000007', segmentation_id='207'                    |
|           | port_id='22000000-0000-4000-8000-000000000008', segmentation_id='208'                    |
+-----------+------------------------------------------------------------------------------------------+
EOF
            ;;
        *) printf 'Unknown synthetic trunk: %s\n' "${4:-}" >&2; exit 1 ;;
    esac
elif [ "$1 $2" = "port show" ]; then
    printf '| id     | %s |\n' "$3"
    echo '| status | DOWN                                |'
else
    printf 'Unexpected mock command: %s\n' "$*" >&2
    exit 1
fi
