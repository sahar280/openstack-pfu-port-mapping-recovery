#!/bin/bash

if [ "$1 $2 $3" = "network trunk list" ]; then
    cat <<'EOF'
+--------------------------------------+-------------------+--------+
| ID                                   | Name              | Status |
+--------------------------------------+-------------------+--------+
| 11111111-1111-4111-8111-111111111111 | pfu-demo-trunk-01 | ACTIVE |
+--------------------------------------+-------------------+--------+
EOF
elif [ "$1 $2 $3" = "network trunk show" ] && [ "${4:-}" = "11111111-1111-4111-8111-111111111111" ] && [ "${5:-}" = "-f" ]; then
    echo "pfu-demo-trunk-01"
elif [ "$1 $2 $3" = "network trunk show" ]; then
    cat <<'EOF'
+----------+------------------------------------------------------------------------------------------------------------------------------------------------+
| Field    | Value                                                                                                                                          |
+----------+------------------------------------------------------------------------------------------------------------------------------------------------+
| sub_ports | port_id='22222222-2222-4222-8222-222222222222', segmentation_id='101' |
|           | port_id='33333333-3333-4333-8333-333333333333', segmentation_id='102' |
+----------+------------------------------------------------------------------------------------------------------------------------------------------------+
EOF
elif [ "$1 $2" = "port show" ]; then
    printf '| id | %s |\n' "$3"
    echo '| status | DOWN |'
else
    printf 'Unexpected mock command: %s\n' "$*" >&2
    exit 1
fi
